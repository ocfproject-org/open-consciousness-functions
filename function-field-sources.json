        "/entries/hplus.function.ocf-bod-010.closer/text": {
          "file": "locales/en-US/OCF-BOD-010-Nutricia.yaml",
          "value": "Remember, Nutricia allows you to select between fuller nourishment and energy utilization with \"{{ cue.primary }},\" or sufficient nourishment with reduced unnecessary retention and storage with \"{{ cue.id.OCF-CMD-BOD-010-FOOD-LESS }}.\"\n\nYour last selected mode remains active until you deliberately change it.\n\nTo select, change, or reinforce your mode, inhale deeply and gently hold your breath.\n\nSilently say to yourself either \"{{ cue.primary }}\" or \"{{ cue.id.OCF-CMD-BOD-010-FOOD-LESS }}.\"\n\nThen slowly exhale through your mouth.\n\nThis concludes your OCF Nutricia exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-010.closer/text"
        },
