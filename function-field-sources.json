        "/entries/hplus.function.ocf-aut-001.closer/text": {
          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "Remember, whenever you wish to make a learned action or skill more automatic, think of the activity and the result you want to accomplish.\n\nInhale deeply and gently hold your breath.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nThe learned action becomes easier to perform while remaining under your conscious control.\n\nThis concludes your OCF Automatic Action exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-aut-001.closer/text"
        },
