        },
        "/entries/hplus.function.ocf-exp-003.closer/text": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "Remember, whenever you wish to dissolve an unwanted belief, expectation, emotional response, or recurring pattern, identify what you want to release.\n\nTake a deep breath in and gently hold it.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nThis concludes your OCF Dissolve exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.closer/text"
