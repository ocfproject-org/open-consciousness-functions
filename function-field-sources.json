        "/entries/hplus.function.ocf-sen-001.closer/text": {
          "file": "locales/en-US/OCF-SEN-001-Hearing.yaml",
          "value": "Remember, whenever you wish to adjust your awareness of sound, close your eyes.\n\nTake a deep breath in and gently hold it.\n\nSilently say to yourself,\n\"{{ cue.primary }}\" to increase awareness, or \"{{ cue.id.OCF-CMD-SEN-001-HEAR-LESS }}\" to reduce unwanted sound.\n\nThen slowly exhale through your mouth and open your eyes.\n\nThis concludes your OCF Hearing exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-001.closer/text"
        },
