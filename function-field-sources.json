        "/entries/hplus.function.ocf-exp-006.closer/text": {
          "file": "locales/en-US/OCF-EXP-006-Intuition.yaml",
          "value": "Remember, whenever you wish to receive intuitive guidance, bring your question or situation into awareness.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nAllow understanding to arise, and consider what it means.\n\nThis concludes your OCF Intuition exercise.",
