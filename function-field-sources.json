          "yaml_pointer": "/entries/hplus.function.ocf-emg-002.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-emg-002.function-body/status": {
          "file": "locales/en-US/OCF-EMG-002-Toxic-Exposure-Response.yaml",
