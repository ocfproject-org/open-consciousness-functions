        "/entries/hplus.function.ocf-exp-007.guided-healing-start/text": {
          "file": "locales/en-US/OCF-EXP-007-Energy-Ball.yaml",
          "value": "For this first practice, choose healing and restoration as your intention.\n\nImagine filling your Energy Ball with that quality.\n\nIt may take the form of a color, warmth, a gentle flow, a feeling you associate with healing, or simply the intention itself.\n\nIf you have learned {{ function.title.OCF-FND-001 }} and would like to use it here, first choose the purpose or result you want from this healing practice.\n\nThen think or say in your mind, \"{{ cue.id.OCF-CMD-FND-001-PRIMARY }}.\"\n\nHold your intended result in your awareness.\n\nYou can also continue by simply imagining or intending healing and restoration within your ball.\n\nLet the ball remain expanded and turning while you rest with that intention.\n\nSpend the next minute becoming familiar with the experience.\n\nYou may notice a feeling or a change in how you imagine the ball, or simply rest with the intention you have chosen.\n\nI will tell you when we continue.\n\nBegin now.",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-007.guided-healing-start/text"
        },
        "/entries/hplus.function.ocf-exp-007.guided-healing-start/version": {
          "file": "locales/en-US/OCF-EXP-007-Energy-Ball.yaml",
          "value": "1.0.0",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-007.guided-healing-start/version"
        },
