        "/entries/hplus.function.ocf-com-001.closer/text": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "Remember, whenever you wish to speak, read aloud, or communicate more clearly and confidently, inhale deeply and gently hold your breath.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nThis concludes your OCF Speak Up exercise.",
