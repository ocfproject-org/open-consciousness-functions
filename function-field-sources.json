        "/entries/hplus.function.ocf-cog-005.closer/text": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "Remember, whenever you wish to explore your possibilities, close your eyes.\n\nTake a deep breath in and gently hold it.\n\nThink of the situation or decision you wish to explore.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth, keeping your eyes closed.\n\nThis concludes your OCF Options exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.closer/text"
