        },
        "/entries/hplus.function.ocf-emo-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "OCF-EMO-001",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-emo-001.function-body/status": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/status"
        },
        "/entries/hplus.function.ocf-emo-001.function-body/text": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "From this moment forward, you have the ability to release unwanted or interfering emotions whenever you choose.\n\nYour mind and body work together to maintain emotional balance, allowing you to experience emotions without being controlled by them.\n\nWhenever an emotion interferes with your peace, clarity, or actions, identify the feeling you wish to release.\n\nTake a deep breath in and gently hold it.\n\nWhile holding your breath, silently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nAs you exhale, let the unwanted emotion release its hold on you.\n\nIts intensity fades, allowing you to regain calm, clarity, and freedom in how you respond.\n\nUnnecessary emotional tension releases, while your natural ability to feel, understand, and express emotions remains intact.\n\nYou retain useful memories and understanding from the experience without continuing to carry the unwanted emotional disturbance.\n\nYour mind and body naturally return to emotional balance.\n\nThis ability to consciously release unwanted emotions is permanently established within you and remains available whenever you choose.\n\nEach time you use \"{{ cue.primary }},\" releasing unwanted emotions becomes easier and more natural.",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/text"
