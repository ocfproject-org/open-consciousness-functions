          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/status": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/status"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/text": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "From this moment forward, you have the ability to explore the possibilities and choices available to you in any area of your life.\n\nYour conscious mind, subconscious mind, higher self, and total self work together, drawing upon your experiences, knowledge, and greater awareness.\n\nThis connection allows you to recognize possibilities and opportunities beyond those ordinarily considered by your conscious mind.\n\nWhenever you wish to explore your options, close your eyes.\n\nTake a deep breath in and gently hold it.\n\nWhile holding your breath, think of the situation, decision, or activity you wish to explore.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth, keeping your eyes closed.\n\nYour total self brings forward possibilities, alternative choices, and potential outcomes related to your selected situation.\n\nDifferent pathways become clearer, along with their opportunities, advantages, challenges, and possible consequences.\n\nYour greater awareness draws upon your knowledge, experiences, intuition, and higher consciousness to reveal options you may not previously have considered.\n\nInsights may arise as thoughts, memories, feelings, intuitive understanding, or new ideas.\n\nYou can consider each possibility, recognize its potential, and understand how different choices may influence your direction.\n\nYour ability to explore possibilities remains permanently available.\n\nYour total self continues forming useful connections and insights, even when you are not consciously exploring a particular situation.\n\nEach time you use \"{{ cue.primary }},\" recognizing and understanding available choices becomes easier and more natural.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/text"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/version": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/version"
        },
