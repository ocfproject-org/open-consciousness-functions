        },
        "/entries/hplus.function.ocf-fnd-001.closer/text": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "Remember, whenever you wish to access and direct your M energy, think of the purpose or result you desire.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nHold your intended result in your awareness and allow your total self to direct its energy toward that purpose.\n\nThis concludes your OCF Access to Energy exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.closer/text"
