        "/entries/hplus.function.ocf-prf-001.closer/text": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "Remember, whenever you wish to begin, continue, or complete an activity, think of the activity you choose.\n\nInhale deeply and gently hold your breath.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nThis concludes your OCF Do This Now exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.closer/text"
        },
