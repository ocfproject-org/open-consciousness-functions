          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.closer/version"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
