          "file": "locales/en-US/OCF-PRF-003-Coordination.yaml",
          "value": "1.3.0",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-003.closer/version"
        },
        "/entries/hplus.function.ocf-prf-003.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-PRF-003-Coordination.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-003.function-body/cue_template/allowed/0"
