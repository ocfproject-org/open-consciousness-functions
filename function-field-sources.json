        "/entries/hplus.function.ocf-prf-003.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-PRF-003-Coordination.yaml",
          "value": "OCF-PRF-003",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-003.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-prf-003.function-body/status": {
          "file": "locales/en-US/OCF-PRF-003-Coordination.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-003.function-body/status"
        },
        "/entries/hplus.function.ocf-prf-003.function-body/text": {
          "file": "locales/en-US/OCF-PRF-003-Coordination.yaml",
          "value": "From this moment forward, let your mind, nervous system, and muscles work together in increasingly smooth and precise coordination.\n\nSignals throughout your nervous system travel quickly and efficiently, allowing your muscles to respond accurately and at the right moment.\n\nYour entire body moves with greater balance, control, accuracy, and natural ease.\n\nEach movement flows smoothly into the next, without unnecessary hesitation, tension, or effort.\n\nYour hands, feet, eyes, and muscles coordinate naturally, supporting accurate timing and effortless movement.\n\nWhen quick action is needed, your responses become faster and more precise.\n\nWhen careful control is needed, your movements remain steady, balanced, and accurate.\n\nYour mind and body work together automatically, allowing you to move without consciously directing every muscle or action.\n\nThis pattern of improved coordination is permanently established within you.\n\nYour natural balance, timing, and movement precision continue strengthening through everyday activity and experience.\n\nWhenever you wish to reinforce this coordination, take a deep breath in and gently hold it.\n\nWhile holding your breath, silently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nAs you exhale, let your entire physical system work together in smoother, faster, and more accurate coordination.\n\nThe more you use this command, the easier and more effective this reinforcement becomes.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-003.function-body/text"
        },
        "/entries/hplus.function.ocf-prf-003.function-body/version": {
          "file": "locales/en-US/OCF-PRF-003-Coordination.yaml",
