          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/status": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/status"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/text": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "From this moment forward, you have the ability to turn your intentions into action whenever you choose.\n\nWhether you wish to begin something new, continue an activity already underway, or bring something to completion, your total self is ready to move forward.\n\nYour conscious mind, subconscious mind, physical body, and higher self work together, directing their resources toward the activity you choose.\n\nUnnecessary hesitation, delay, and resistance fade away, allowing energy, willingness, and enthusiasm to arise naturally.\n\nYou move into action with confidence, clarity, and a sense of purpose.\n\nEach step creates momentum for the next, making it easier to maintain your progress and complete what you have chosen to accomplish.\n\nYour attention and energy remain aligned with the activity, helping you follow through from beginning to completion.\n\nWhenever you wish to activate this ability, think of the activity you want to begin, continue, or complete.\n\nTake a deep breath in and gently hold it.\n\nWhile holding your breath, silently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nAs you exhale, let your intention become action, moving forward with confidence and momentum.\n\nThis ability to begin, continue, and complete chosen activities remains available whenever you need it.\n\nThe more you use this command, the easier and more natural moving from intention into action becomes.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/text"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/version": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/version"
        },
