        "/entries/hplus.function.ocf-prf-006.function-body/status": {
          "file": "locales/en-US/OCF-PRF-006-Strong-Quick.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-006.function-body/status"
        },
        "/entries/hplus.function.ocf-prf-006.function-body/text": {
          "file": "locales/en-US/OCF-PRF-006-Strong-Quick.yaml",
          "value": "From this moment forward, you have the ability to call upon exceptional reserves of strength and quickness within your total self.\n\nWhen an immediate need arises, your mind and body can work together with increased speed, strength, precision, and coordination.\n\nTo activate this ability, identify the action you need to perform.\n\nTake a deep breath in and gently hold it.\n\nWhile holding your breath, silently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nYour total self responds to your intention, bringing your available strength, speed, and coordination into the chosen action.\n\nYour conscious mind, subconscious mind, nervous system, and muscles work together, reducing unnecessary hesitation and wasted movement.\n\nYour awareness remains clear as your movements become direct, rapid, and precise.\n\nYour body directs its available resources toward the immediate task, maintaining the awareness and control needed for effective action.\n\nThis enhanced response continues for as long as the immediate need exists.\n\nWhen the need has passed, the enhanced response ends naturally, and your mind and body return to their normal operating state.\n\nYour learned ability remains permanently available for future use.\n\nEach time you use \"{{ cue.primary }},\" accessing and directing this ability becomes easier and more natural.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-006.function-body/text"
        },
        "/entries/hplus.function.ocf-prf-006.function-body/version": {
