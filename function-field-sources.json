        "/entries/hplus.function.ocf-sen-005.closer/text": {
          "file": "locales/en-US/OCF-SEN-005-Touch.yaml",
          "value": "Remember, to regulate your physical sense of touch\nor strengthen your inner experience of it, close your eyes,\ninhale deeply, and hold your breath.\nThink or say in your mind, \"{{ cue.primary }}\"\nor \"{{ cue.id.OCF-CMD-SEN-005-TOUCH-LESS }},\" according to your intention.\nThen slowly exhale through your mouth and open your eyes.\n\nThis concludes your OCF Touch exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-005.closer/text"
