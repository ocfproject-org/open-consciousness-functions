        "/entries/hplus.function.ocf-aut-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "OCF-AUT-001",
          "yaml_pointer": "/entries/hplus.function.ocf-aut-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-aut-001.function-body/status": {
          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-aut-001.function-body/status"
        },
        "/entries/hplus.function.ocf-aut-001.function-body/text": {
          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "From this moment forward, you have the ability to turn learned actions and skills into smooth, natural, automatic responses.\n\nYour mind, nervous system, and body work together, developing coordinated patterns that become easier and more efficient through practice.\n\nEach repetition strengthens your familiarity with the selected activity, allowing its individual steps to flow together naturally.\n\nUnnecessary hesitation and effort diminish as the skill becomes increasingly automatic.\n\nWhenever you wish to develop this ability for a particular activity, first think of the skill or action you have already learned to perform.\n\nRecognize its important steps and the result you want to accomplish.\n\nYou do not need to picture yourself performing it. Simply know the activity and understand how it should be carried out.\n\nTake a deep breath in and gently hold it.\n\nWhile holding your breath, silently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nAs you exhale, let the selected skill become more natural, coordinated, and automatic.\n\nYour mind and body organize the learned pattern so that, whenever you choose to perform the activity, its individual steps flow together with increasing ease, speed, and precision.\n\nYou remain fully aware and in control, able to begin, guide, adjust, improve, or stop the activity whenever you choose.\n\nThe learned pattern remains available without causing the action to occur on its own.\n\nEach time you perform the selected skill, its automatic pattern becomes stronger, smoother, and more reliable.\n\nThis ability to develop and retain automatic skills is permanently established within you.\n\nThe more you use \"{{ cue.primary }},\" the easier and more effective developing these learned patterns becomes.",
          "yaml_pointer": "/entries/hplus.function.ocf-aut-001.function-body/text"
        },
