        },
        "/entries/hplus.function.ocf-fnd-001.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-fnd-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "OCF-FND-001",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-fnd-001.function-body/status": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/status"
        },
        "/entries/hplus.function.ocf-fnd-001.function-body/text": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "From this moment forward, you have the ability to recognize, access, and direct the M energy of your total self.\n\nM energy is the energy available throughout your total being, connecting your conscious mind, subconscious mind, and higher self.\n\nYou can call upon this energy whenever you choose, directing it toward the goals and purposes that matter to you.\n\nYou may recognize M energy as warmth, light, movement, vibration, or a simple sense of knowing.\n\nNo particular sensation or mental image is required. You can access and direct M energy simply through conscious intention.\n\nYour conscious mind, subconscious mind, and higher self work together, coordinating this energy toward the purpose you select.\n\nYou may direct M energy toward healing and restoration, protection and balance, strength and stamina, clear thinking, insight, or heightened awareness.\n\nYou may direct it toward your physical body, your total self, or broader purposes you consciously choose.\n\nYour intention gives this energy its direction, allowing your total self to work toward the result you desire.\n\nThis ability to access and direct M energy is permanently established within you.\n\nWhenever you wish to use it, first think of the purpose or result you want to accomplish.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen hold your intended result in your awareness.\n\nThere is no need to picture it. Simply know what you want to accomplish and allow your total self to respond to that intention.\n\nLet your M energy organize and flow toward your chosen purpose, working naturally without unnecessary effort.\n\nThe more you use this command, the easier and more effective directing your M energy becomes.\n\nNow, take a moment to practice.\n\nChoose something you wish to accomplish or strengthen.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nRecognize your chosen purpose and allow your total self to direct its resources toward that result.\n\nYour ability to access and direct M energy remains available whenever you choose to use it.",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/text"
        },
