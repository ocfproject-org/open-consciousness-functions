        "/entries/hplus.function.ocf-emo-001.closer/text": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "Remember, whenever you wish to release an unwanted emotion, first identify the feeling you want to let go.\n\nTake a deep breath in and gently hold it.\n\nSilently say to yourself,\n\"{{ cue.primary }}.\"\n\nThen slowly exhale through your mouth.\n\nThis concludes your OCF Let Go exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.closer/text"
